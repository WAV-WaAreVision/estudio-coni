# Supabase (local: `supabase start` prints these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Trigger.dev tasks (the production tasks write as service_role: keep this key out of the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRIGGER_PROJECT_REF=

# Cloudflare R2, private storage for voices and videos (the Trigger.dev tasks read them; no public bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Alerts by email through Resend (design A5/A9): the sender must be on a domain verified in Resend
RESEND_API_KEY=
AVISOS_REMITENTE=
AVISOS_CORREO_CONI=
# The only address the app signs in (Coni's code is emailed there). Falls back to AVISOS_CORREO_CONI.
CORREO_CONI=
AVISOS_CORREO_WAV=

# Web Push to Coni's installed app (Plan 6). Generate the pair once with `pnpm exec web-push generate-vapid-keys`. The same
# three go in Vercel (the app sends the "Enviar uno de prueba" push) and in Trigger.dev (the tasks send the notices).
# The subject is a mailto: or https: address the push service can reach WAV at. Without them notices go by email only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Nightly backup (design D6): the direct connection string of the Supabase database, for pg_dump
RESPALDO_DB_URL=

# The app starts Trigger.dev runs (producir-pieza, grabar-pieza) when Coni approves. Never set it in tests.
TRIGGER_SECRET_KEY=
# Local E2E only: records the runs the app would start in a file instead of calling Trigger.dev (ignored on Vercel).
DISPARO_DE_PRUEBA=

# "Conectar Instagram" (design A6): the Meta app of Coni's business portfolio (Instagram API with Instagram Login).
# The redirect URI must be exactly the one registered in the app, on the app's own domain: https://<dominio>/api/meta/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Local E2E only: the address of the fake Anthropic, HeyGen, ElevenLabs, Instagram and push service (refused when VERCEL is set).
ANTHROPIC_BASE_URL=
HEYGEN_BASE_URL=
ELEVENLABS_BASE_URL=
INSTAGRAM_OAUTH_BASE_URL=
INSTAGRAM_GRAPH_BASE_URL=
# Local E2E only: replaces the origin of every push endpoint, so the app sends to the fake push service instead.
PUSH_BASE_URL=
# Secret behind the daily salt of the click counter of /l (any long random string). Never stored with a click. In
# production without it the clicks of /l are not counted (the visitor still reaches the link).
SAL_DE_CLICS=
