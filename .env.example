# Supabase (local: `supabase start` prints these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Trigger.dev tasks (the production tasks write as service_role: keep this key out of the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRIGGER_PROJECT_REF=

# Cloudflare R2, private storage for voices and videos (the Trigger.dev tasks read them; no public bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Alerts by email through Resend (design A5/A9): the sender must be on a domain verified in Resend
RESEND_API_KEY=
AVISOS_REMITENTE=
AVISOS_CORREO_CONI=
AVISOS_CORREO_WAV=

# Nightly backup (design D6): the direct connection string of the Supabase database, for pg_dump
RESPALDO_DB_URL=
